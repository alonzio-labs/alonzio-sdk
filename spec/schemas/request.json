{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alonzio.com/spec/1.0/request.json",
  "title": "Request",
  "type": "object",
  "required": [
    "type",
    "need"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "ask",
        "delegate",
        "negotiate",
        "represent"
      ]
    },
    "need": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1000
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 10
    },
    "max_providers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "answer_window_hours": {
      "type": "number",
      "minimum": 1,
      "maximum": 336
    },
    "mandate": {
      "$ref": "mandate.json"
    }
  }
}
